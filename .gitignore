# Raw dataset (~500MB) — never committed
data/raw/*
!data/raw/.gitkeep

# Generated benchmark datasets (CSV/JSON/Parquet/ORC outputs) — never committed
data/generated/*
!data/generated/.gitkeep

# Logs
logs/*
!logs/.gitkeep

# Spark / Python housekeeping
__pycache__/
*.pyc
.ipynb_checkpoints/
spark-warehouse/
metastore_db/
derby.log
.DS_Store
